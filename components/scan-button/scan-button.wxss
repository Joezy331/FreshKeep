.sb {
  display: flex;
  align-items: center;
  padding: 40rpx 36rpx;
  border-radius: var(--fk-r-lg);
  background: linear-gradient(135deg, #7e8c6a 0%, #616e50 100%);
  box-shadow: 0 16rpx 40rpx rgba(126, 140, 106, 0.28);
  transition: transform 0.18s ease;
}

.sb-hover {
  transform: scale(0.985);
}

.sb.compact {
  padding: 28rpx;
  background: var(--fk-card);
  box-shadow: var(--fk-shadow-m);
}

.sb.compact .sb-title {
  color: var(--fk-ink-900);
}

.sb.compact .sb-sub {
  color: var(--fk-ink-500);
}

.sb.compact .sb-arrow {
  color: var(--fk-ink-300);
}

.sb-ring {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sb.compact .sb-ring {
  background: var(--fk-brand-soft);
}

.sb-emoji {
  font-size: 44rpx;
  z-index: 2;
}

.sb-ring-1,
.sb-ring-2 {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.35);
}

.sb.compact .sb-ring-1,
.sb.compact .sb-ring-2 {
  border-color: rgba(126, 140, 106, 0.28);
}

.sb-ring-2 {
  animation: fk-breathe 2.4s ease-in-out infinite;
}

.sb-main {
  flex: 1;
  min-width: 0;
  margin-left: 28rpx;
}

.sb-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: -0.3rpx;
}

.sb-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.78);
}

.sb-arrow {
  font-size: 44rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-left: 12rpx;
}
