.es {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 72rpx 32rpx;
}

.es-icon {
  font-size: 88rpx;
  line-height: 1;
  opacity: 0.85;
  margin-bottom: 24rpx;
}

.es-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--fk-ink-900);
}

.es-desc {
  font-size: 24rpx;
  color: var(--fk-ink-500);
  margin-top: 10rpx;
  text-align: center;
  line-height: 1.7;
  max-width: 480rpx;
}

.es-btn {
  margin-top: 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 40rpx;
  border-radius: 999rpx;
  background: var(--fk-brand-soft);
  color: var(--fk-brand-dark);
  font-size: 26rpx;
  font-weight: 500;
}
