.ic {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background: var(--fk-card);
  border-radius: var(--fk-r-md);
  box-shadow: var(--fk-shadow-s);
}

.ic-emoji {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--fk-fill);
}

.ic-emoji.s-soon,
.ic-emoji.s-urgent {
  background: var(--fk-warn-soft);
}

.ic-emoji.s-expired {
  background: var(--fk-danger-soft);
}

.ic-emoji-text {
  font-size: 44rpx;
  line-height: 1;
}

.ic-pulse {
  position: absolute;
  right: -4rpx;
  top: -4rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--fk-warn);
  animation: fk-breathe 1.8s ease-in-out infinite;
}

.ic-main {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.ic-line1 {
  display: flex;
  align-items: baseline;
}

.ic-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--fk-ink-900);
}

.ic-qty {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--fk-ink-300);
}

.ic-line2 {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: var(--fk-ink-500);
}

.ic-dot {
  margin: 0 8rpx;
  color: var(--fk-ink-100);
}

.ic-left.t-soon,
.ic-left.t-urgent {
  color: var(--fk-warn);
}

.ic-left.t-expired {
  color: var(--fk-danger);
}

.ic-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.ic-btn {
  margin-top: 12rpx;
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: var(--fk-brand-soft);
  color: var(--fk-brand-dark);
  font-size: 22rpx;
  font-weight: 500;
}
