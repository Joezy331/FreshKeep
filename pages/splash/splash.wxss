.splash {
  position: relative;
  min-height: 100vh;
  background: var(--fk-bg);
  display: flex;
  flex-direction: column;
  align-items: center;
  /* 主体在屏幕垂直方向居中；下内边距略大，抵消底部进度区，视觉重心稍高于几何中心 */
  justify-content: center;
  padding-top: calc(80rpx + env(safe-area-inset-top));
  padding-bottom: 220rpx;
  box-sizing: border-box;
  overflow: hidden;
  transition: opacity 0.42s ease, transform 0.42s ease;
}

.splash.out {
  opacity: 0;
  transform: scale(1.02);
}

/* 飘落叶子 */
.leaf {
  position: absolute;
  width: 76rpx;
  height: 76rpx;
  opacity: 0;
}

.leaf.l1 {
  left: 88rpx;
  top: 120rpx;
}

.leaf.l2 {
  right: 96rpx;
  top: 200rpx;
  width: 58rpx;
  height: 58rpx;
  animation-delay: 3.2s;
}

/* 跳过 */
.skip {
  position: absolute;
  right: 44rpx;
  top: calc(40rpx + env(safe-area-inset-top));
  padding: 10rpx 26rpx;
  border: 2rpx solid var(--fk-line-strong);
  border-radius: var(--fk-r-pill);
  font-size: 22rpx;
  color: var(--fk-ink-500);
  letter-spacing: 2rpx;
}

/* 主插画 */
.hero {
  width: 420rpx;
  height: 420rpx;
}

.hero-img {
  width: 100%;
  height: 100%;
}

/* 品牌 */
.brand {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-line {
  display: flex;
  align-items: flex-start;
}

.brand-cn {
  font-size: 72rpx;
  font-weight: 600;
  letter-spacing: 14rpx;
  color: var(--fk-ink-900);
  line-height: 1.1;
  /* 让字距居中：抵消尾部多余间距 */
  margin-left: 14rpx;
}

.seal {
  margin-left: 6rpx;
  margin-top: 10rpx;
  transform: rotate(6deg);
}

.brand-en {
  margin-top: 16rpx;
}

.slogan {
  margin-top: 40rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: var(--fk-ink-500);
}

.motto {
  margin-top: 16rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: var(--fk-ink-300);
}

/* 底部 */
.foot {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(80rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
}

.bar {
  position: relative;
  width: 220rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: var(--fk-line);
}

.bar-fill {
  height: 100%;
  background: var(--fk-brand);
  border-radius: 3rpx;
  transition: width 0.12s linear;
}

/* 进度条头部的小光点，跟着进度走 */
.bar-head {
  position: absolute;
  top: 50%;
  width: 10rpx;
  height: 10rpx;
  margin-left: -5rpx;
  margin-top: -5rpx;
  border-radius: 50%;
  background: var(--fk-brand);
  box-shadow: 0 0 0 6rpx rgba(126, 140, 106, 0.14);
  transition: left 0.12s linear;
}

.enter {
  margin-top: 26rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--fk-brand);
  padding: 10rpx 30rpx;
  border: 2rpx solid var(--fk-line-strong);
  border-radius: var(--fk-r-pill);
}

.nav-err {
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  border-radius: var(--fk-r-sm);
  background: var(--fk-danger-soft);
  color: var(--fk-danger);
  font-size: 20rpx;
  text-align: center;
  max-width: 560rpx;
  line-height: 1.7;
}

.nav-retry {
  margin-top: 10rpx;
  color: var(--fk-ink-900);
  text-decoration: underline;
}

.foot-en {
  margin-top: 20rpx;
}
