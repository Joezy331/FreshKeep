<view class="page">

  <view class="hd">
    <view>
      <view class="hd-title">我的冰箱</view>
      <view class="hd-sub">
        当前 {{stats.kinds}} 种食材 · {{stats.items}} 件
        <text wx:if="{{stats.attention > 0}}" class="hd-warn">· {{stats.attention}} 种需要优先处理</text>
      </view>
    </view>
    <view class="hd-add" bindtap="showAddSheet">+ 添加</view>
  </view>

  <!-- 搜索 -->
  <view class="search">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      placeholder="搜索食材，如 西红柿"
      placeholder-class="search-ph"
      value="{{keyword}}"
      bindinput="onSearch"
      confirm-type="search"
    />
    <text class="search-clear" wx:if="{{keyword}}" bindtap="onClearKeyword">✕</text>
  </view>

  <!-- 分类 -->
  <scroll-view scroll-x class="cats">
    <view class="cats-inner">
      <view
        class="cat {{activeCategory === c ? 'on' : ''}}"
        wx:for="{{categories}}"
        wx:for-item="c"
        wx:key="*this"
        data-cat="{{c}}"
        bindtap="onCategory"
      >{{c}}</view>
    </view>
  </scroll-view>

  <!-- 冰箱分区 -->
  <view class="zones" wx:if="{{zones.length > 0}}">
    <fridge-section
      wx:for="{{zones}}"
      wx:for-item="z"
      wx:key="area"
      zone="{{z}}"
      open="{{true}}"
      bind:itemtap="onItemTap"
    />
  </view>

  <view wx:if="{{stats.kinds === 0 && !loading}}">
    <empty-state
      icon="🧊"
      title="冰箱还空着"
      desc="拍照识别或手动添加，把买回来的菜记进冰箱。"
      btnText="添加食材"
      bind:action="goScan"
    />
  </view>

  <view wx:if="{{stats.kinds > 0 && zones.length > 0 && !hasResult}}">
    <empty-state icon="🔍" title="没有找到相关食材" desc="换个关键词或切换分类试试" />
  </view>

  <view class="fk-disclaimer">
    最佳食用期为参考值，请结合食材实际状态判断是否可食用。
  </view>
</view>
