<view class="page" wx:if="{{user}}">

  <!-- 用户信息 -->
  <view class="me">
    <view class="avatar">{{initial}}</view>
    <view class="me-main">
      <view class="me-name" bindtap="editNickname">
        {{user.nickname}}
        <text class="me-edit">改名</text>
      </view>
      <view class="me-sub">{{user.preferences.householdSize}} 人家庭 · 已记录 {{stats.kinds}} 种食材</view>
    </view>
  </view>

  <!-- 数据概览 -->
  <view class="card">
    <view class="card-title">我的冰箱</view>
    <view class="grid">
      <view class="cell">
        <view class="cell-num">{{stats.kinds}}</view>
        <view class="cell-label">食材种类</view>
      </view>
      <view class="cell">
        <view class="cell-num">{{stats.items}}</view>
        <view class="cell-label">食材件数</view>
      </view>
      <view class="cell">
        <view class="cell-num warn">{{stats.soon + stats.urgent}}</view>
        <view class="cell-label">即将到期</view>
      </view>
      <view class="cell">
        <view class="cell-num danger">{{stats.expired}}</view>
        <view class="cell-label">已过期</view>
      </view>
    </view>
    <view class="card-link" bindtap="goFridge">管理冰箱食材 ›</view>
  </view>

  <!-- 菜单 -->
  <view class="card">
    <view class="menu" bindtap="openNotify">
      <text class="menu-icon">⏰</text>
      <text class="menu-text">临期提醒</text>
      <text class="menu-tail">通知中心 ›</text>
    </view>
    <view class="menu" bindtap="comingSoon">
      <text class="menu-icon">👨‍👩‍👧</text>
      <text class="menu-text">家庭成员</text>
      <text class="menu-tail">和家人共享冰箱 ›</text>
    </view>
  </view>

  <!-- 饮食偏好 -->
  <view class="card">
    <view class="card-title">饮食偏好</view>
    <view class="chips">
      <view
        class="chip {{dislikeMap[d] ? 'on' : ''}}"
        wx:for="{{dislikes}}"
        wx:for-item="d"
        wx:key="*this"
        data-key="{{d}}"
        bindtap="onDislike"
      >{{d}}</view>
    </view>
  </view>

  <!-- 百度智能云（仅管理员可见） -->
  <view class="card" wx:if="{{isAdmin}}">
    <view class="card-title">百度智能云 · 菜品识别</view>
    <view class="field">
      <view class="field-label">API Key</view>
      <input
        class="field-input"
        password="{{true}}"
        value="{{baidu.apiKey}}"
        placeholder="百度智能云 API Key"
        placeholder-class="field-ph"
        bindblur="onBaiduApiKey"
      />
    </view>
    <view class="field">
      <view class="field-label">Secret Key</view>
      <input
        class="field-input"
        password="{{true}}"
        value="{{baidu.secretKey}}"
        placeholder="百度智能云 Secret Key"
        placeholder-class="field-ph"
        bindblur="onBaiduSecretKey"
      />
    </view>
    <view class="card-tiny">仅管理员可见。Secret Key 仅存本地；生产环境请改为后端代理调用，密钥不下发前端。</view>
  </view>

  <!-- AI 引擎（仅管理员可见） -->
  <view class="card" wx:if="{{isAdmin && ai}}">
    <view class="card-title">
      AI 引擎
      <text class="card-tail">{{ai.provider === 'opencode' ? '真实模型' : '本地演示'}}</text>
    </view>

    <view class="seg">
      <view
        class="seg-item {{ai.provider === 'mock' ? 'on' : ''}}"
        data-p="mock"
        bindtap="onAiProvider"
      >Mock 演示</view>
      <view
        class="seg-item {{ai.provider === 'opencode' ? 'on' : ''}}"
        data-p="opencode"
        bindtap="onAiProvider"
      >在线模型</view>
    </view>

    <!-- 网关切换 -->
    <view class="presets">
      <view
        class="preset {{ai.baseUrl === item.url ? 'on' : ''}}"
        wx:for="{{basePresets}}"
        wx:for-item="item"
        wx:key="url"
        data-url="{{item.url}}"
        bindtap="onBaseUrlPreset"
      >{{item.label}}</view>
    </view>

    <!-- 使用提示 -->
    <view class="ai-help" bindtap="copyZenUrl">
      <view class="ai-help-title">网关：{{ai.baseUrl}}</view>
      <view class="ai-help-step">模型：{{ai.model}}</view>
      <view class="ai-help-step">
        Muse Spark 1.3 需在 OpenRouter 完成一次 18+ 确认才能调用（点此复制官网地址）
      </view>
      <view class="ai-help-free">
        备选免费视觉模型：inclusionai/ling-3.0-flash-vl:free，点「拉取模型」可看全部
      </view>
    </view>

    <block wx:if="{{ai.provider === 'opencode'}}">
      <view class="field">
        <view class="field-label">API Key</view>
        <input
          class="field-input"
          password="{{true}}"
          value="{{ai.apiKey}}"
          placeholder="在 opencode.ai/zen 创建后粘贴"
          placeholder-class="field-ph"
          bindblur="onApiKey"
        />
      </view>

      <view class="field">
        <view class="field-label">接口地址</view>
        <input
          class="field-input"
          value="{{ai.baseUrl}}"
          placeholder="https://opencode.ai/zen/v1"
          placeholder-class="field-ph"
          bindblur="onBaseUrl"
        />
      </view>

      <view class="field">
        <view class="field-label">模型</view>
        <picker mode="selector" range="{{modelLabels}}" value="{{0}}" bindchange="onPickModel">
          <view class="field-value">{{ai.model}} ⌄</view>
        </picker>
      </view>

      <view class="field">
        <view class="field-main">
          <view class="field-label">失败自动降级 Mock</view>
          <view class="field-sub">真实模型报错时自动改用本地识别，演示不中断</view>
        </view>
        <switch checked="{{ai.fallbackToMock}}" color="#5C8A6B" bindchange="onAiFallback" />
      </view>

      <view class="dev-btns">
        <view class="dev" bindtap="onTestAi">测试连接</view>
        <view class="dev" bindtap="onFetchModels">拉取模型</view>
        <view class="dev" bindtap="onCustomModel">手输模型</view>
      </view>

      <view class="field" wx:if="{{fetchedModels.length > 0}}">
        <view class="field-label">网关模型（{{fetchedModels.length}}）</view>
        <picker
          mode="selector"
          range="{{fetchedModels}}"
          value="{{0}}"
          bindchange="onPickFetchedModel"
        >
          <view class="field-value">点击选择 ⌄</view>
        </picker>
      </view>

      <view class="ai-status">{{aiStatus}}</view>

      <view class="card-tiny">
        ⚠️ Key 明文保存在本地，仅供 Demo；正式上线请改为自建服务端 / 云函数中转。
        真机与线上需在小程序后台把 opencode.ai 加入 request 合法域名（境外域名建议自建代理）。
      </view>
    </block>

    <view class="card-tiny" wx:else>
      当前使用本地 Mock 识别，离线也能跑完整流程；切换到 OpenCode Zen 即可调用真实大模型（含免费模型）。
    </view>
  </view>

  <!-- 通知设置 -->
  <view class="card">
    <view class="card-title">通知设置</view>
    <view class="switch-row">
      <view class="switch-main">
        <view class="switch-text">临期提醒</view>
        <view class="switch-sub">食材进入最佳食用期末期时提醒</view>
      </view>
      <switch
        checked="{{user.notificationSettings.expiration}}"
        color="#5C8A6B"
        data-key="expiration"
        bindchange="onSwitch"
      />
    </view>
    <view class="switch-row">
      <view class="switch-main">
        <view class="switch-text">每日做饭提醒</view>
        <view class="switch-sub">每天 {{user.notificationSettings.dailyTipTime}} 推荐今日菜谱</view>
      </view>
      <switch
        checked="{{user.notificationSettings.dailyTip}}"
        color="#5C8A6B"
        data-key="dailyTip"
        bindchange="onSwitch"
      />
    </view>
    <view class="card-tiny">MVP 阶段为本地提醒模拟，已预留微信订阅消息接口。</view>
  </view>

  <!-- 数据统计（仅管理员可见） -->
  <view class="card" wx:if="{{isAdmin && summary}}">
    <view class="card-title">
      产品数据埋点
      <text class="card-tail" bindtap="toggleEvents">{{showEvents ? '收起' : '展开'}}</text>
    </view>
    <view class="metric">
      <view class="m"><view class="m-num">{{summary.recognitionRate}}</view><view class="m-label">AI 识别成功率</view></view>
      <view class="m"><view class="m-num">{{summary.ingredientAdded}}</view><view class="m-label">食材添加数</view></view>
      <view class="m"><view class="m-num">{{summary.ingredientConsumed}}</view><view class="m-label">食材消耗数</view></view>
      <view class="m"><view class="m-num">{{summary.expiringConsumeRate}}</view><view class="m-label">临期消耗率</view></view>
      <view class="m"><view class="m-num">{{summary.recipeCtr}}</view><view class="m-label">食谱点击率</view></view>
      <view class="m"><view class="m-num">{{summary.total}}</view><view class="m-label">事件总数</view></view>
    </view>
    <view class="events" wx:if="{{showEvents}}">
      <view class="ev" wx:for="{{summary.counts}}" wx:for-index="k" wx:for-item="v" wx:key="k">
        <text class="ev-k">{{k}}</text>
        <text class="ev-v">{{v}}</text>
      </view>
    </view>
    <view class="card-link" wx:if="{{showEvents}}" bindtap="clearTrack">清空埋点日志</view>
  </view>

  <!-- 开发选项（仅管理员可见） -->
  <view class="card" wx:if="{{isAdmin}}">
    <view class="card-title">开发 / 演示选项</view>
    <view class="switch-row">
      <view class="switch-main">
        <view class="switch-text">模拟识别失败</view>
        <view class="switch-sub">用于演示 AI 识别错误态</view>
      </view>
      <switch
        checked="{{settings.mockRecognizeFail}}"
        color="#cc5b4a"
        data-key="mockRecognizeFail"
        bindchange="onSettingSwitch"
      />
    </view>
    <view class="switch-row">
      <view class="switch-main">
        <view class="switch-text">模拟网络错误</view>
        <view class="switch-sub">用于演示网络异常态</view>
      </view>
      <switch
        checked="{{settings.mockNetworkError}}"
        color="#cc5b4a"
        data-key="mockNetworkError"
        bindchange="onSettingSwitch"
      />
    </view>
    <view class="dev-btns">
      <view class="dev" bindtap="resetData">恢复演示数据</view>
      <view class="dev danger" bindtap="clearCache">清空本地数据</view>
    </view>
  </view>

  <view class="fk-disclaimer" bindlongpress="toggleAdmin">鲜存 FreshKeep v{{version}} · MVP Demo</view>
</view>

<!-- 通知中心 -->
<view class="mask" wx:if="{{showNotify}}" bindtap="closeNotify">
  <view class="sheet" catchtap="noop">
    <view class="sheet-bar"></view>
    <view class="sheet-head">
      <view class="sheet-title">⏰ 食材提醒</view>
      <view class="sheet-read" bindtap="readAll">全部已读</view>
    </view>
    <scroll-view scroll-y class="sheet-body">
      <view class="nt" wx:for="{{reminders}}" wx:for-item="n" wx:key="id">
        <view class="nt-dot {{n.level}}"></view>
        <view class="nt-main">
          <view class="nt-title">{{n.title}}</view>
          <view class="nt-body">{{n.body}}</view>
        </view>
      </view>
      <view wx:if="{{reminders.length === 0}}" class="nt-empty">暂时没有提醒</view>
    </scroll-view>
  </view>
</view>
