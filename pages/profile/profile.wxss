.page {
  min-height: 100vh;
  padding: 32rpx 32rpx calc(60rpx + env(safe-area-inset-bottom));
}

.me {
  display: flex;
  align-items: center;
  padding: 12rpx 4rpx 36rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--fk-brand);
  color: #fff;
  font-size: 44rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 26rpx rgba(126, 140, 106, 0.22);
}

.me-main {
  margin-left: 28rpx;
}

.me-name {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--fk-ink-900);
}

.me-edit {
  margin-left: 16rpx;
  font-size: 21rpx;
  color: var(--fk-ink-300);
  font-weight: 400;
}

.me-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--fk-ink-500);
}

.card {
  margin-bottom: 28rpx;
  padding: 32rpx;
  border-radius: var(--fk-r-lg);
  background: var(--fk-card);
  box-shadow: var(--fk-shadow-m);
}

.card-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--fk-ink-900);
}

.card-tail {
  font-size: 22rpx;
  color: var(--fk-brand);
  font-weight: 400;
}

.card-tiny {
  margin-top: 18rpx;
  font-size: 20rpx;
  color: var(--fk-ink-300);
  line-height: 1.6;
}

.card-link {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--fk-line);
  font-size: 24rpx;
  color: var(--fk-brand);
  text-align: center;
}

.grid {
  margin-top: 8rpx;
  display: flex;
}

.cell {
  flex: 1;
  text-align: center;
}

.cell-num {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--fk-ink-900);
}

.cell-num.warn {
  color: var(--fk-warn);
}

.cell-num.danger {
  color: var(--fk-danger);
}

.cell-label {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--fk-ink-300);
}

.menu {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--fk-line);
}

.menu:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 30rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--fk-ink-900);
}

.menu-tail {
  font-size: 23rpx;
  color: var(--fk-ink-300);
}

.chips {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
}

.chip {
  padding: 12rpx 26rpx;
  border-radius: var(--fk-r-pill);
  background: var(--fk-fill);
  color: var(--fk-ink-500);
  font-size: 23rpx;
  margin: 0 16rpx 16rpx 0;
}

.chip.on {
  background: var(--fk-brand);
  color: #fff;
}

.seg {
  margin-top: 24rpx;
  display: flex;
  padding: 6rpx;
  border-radius: var(--fk-r-pill);
  background: var(--fk-fill);
}

.seg-item {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: var(--fk-r-pill);
  font-size: 25rpx;
  color: var(--fk-ink-500);
}

.seg-item.on {
  background: var(--fk-card);
  color: var(--fk-brand-dark);
  font-weight: 600;
  box-shadow: var(--fk-shadow-s);
}

.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--fk-line);
}

.ai-help {
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border-radius: var(--fk-r-md);
  background: var(--fk-brand-soft-2);
  border: 2rpx dashed var(--fk-line-strong);
}

.ai-help-title {
  font-size: 23rpx;
  color: var(--fk-brand-dark);
  font-weight: 600;
  margin-bottom: 12rpx;
}

.ai-help-step {
  font-size: 20rpx;
  line-height: 1.8;
  color: var(--fk-ink-500);
}

.ai-help-free {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid var(--fk-line);
  font-size: 19rpx;
  line-height: 1.7;
  color: var(--fk-ink-300);
  word-break: break-all;
}

.field-label {
  font-size: 25rpx;
  color: var(--fk-ink-700);
  flex-shrink: 0;
}

.field-main {
  flex: 1;
  min-width: 0;
}

.field-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--fk-ink-300);
}

.field-input {
  flex: 1;
  text-align: right;
  font-size: 24rpx;
  color: var(--fk-ink-900);
  margin-left: 24rpx;
}

.field-ph {
  color: var(--fk-ink-300);
}

.field-value {
  font-size: 24rpx;
  color: var(--fk-ink-900);
  background: var(--fk-fill);
  padding: 10rpx 22rpx;
  border-radius: var(--fk-r-pill);
  max-width: 400rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ai-status {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: var(--fk-r-sm);
  background: var(--fk-brand-soft-2);
  font-size: 21rpx;
  line-height: 1.6;
  color: var(--fk-ink-700);
  word-break: break-all;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--fk-line);
}

.switch-row:last-of-type {
  border-bottom: none;
}

.switch-text {
  font-size: 27rpx;
  color: var(--fk-ink-900);
}

.switch-sub {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--fk-ink-300);
}

.metric {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
}

.m {
  width: 33.3%;
  text-align: center;
  margin-bottom: 24rpx;
}

.m-num {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--fk-ink-900);
}

.m-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--fk-ink-300);
}

.events {
  padding: 20rpx 0;
  border-top: 2rpx solid var(--fk-line);
}

.ev {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 22rpx;
  color: var(--fk-ink-500);
}

.dev-btns {
  margin-top: 24rpx;
  display: flex;
}

.dev {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: var(--fk-r-sm);
  background: var(--fk-fill);
  color: var(--fk-ink-700);
  font-size: 25rpx;
  margin-right: 20rpx;
}

.dev.danger {
  margin-right: 0;
  background: var(--fk-danger-soft);
  color: var(--fk-danger);
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(31, 36, 33, 0.34);
  z-index: 120;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: var(--fk-card);
  border-radius: 36rpx 36rpx 0 0;
  padding: 20rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  animation: fk-fade-up 0.26s ease both;
}

.sheet-bar {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--fk-line-strong);
  margin: 8rpx auto 24rpx;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--fk-ink-900);
}

.sheet-read {
  font-size: 23rpx;
  color: var(--fk-brand);
}

.sheet-body {
  max-height: 60vh;
  margin-top: 20rpx;
}

.nt {
  display: flex;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--fk-line);
}

.nt-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-top: 12rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
  background: var(--fk-brand);
}

.nt-dot.soon {
  background: var(--fk-warn);
}

.nt-dot.urgent {
  background: var(--fk-warn);
}

.nt-dot.expired {
  background: var(--fk-danger);
}

.nt-title {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--fk-ink-900);
}

.nt-body {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--fk-ink-500);
  line-height: 1.6;
}

.nt-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--fk-ink-300);
}
