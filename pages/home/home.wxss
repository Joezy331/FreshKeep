.page {
  min-height: 100vh;
  padding: 24rpx 32rpx calc(60rpx + env(safe-area-inset-bottom));
}

/* ── Hero ────────────────────────────────────────────── */
.hero {
  position: relative;
  padding: 20rpx 4rpx 44rpx;
}

.hero-leaf {
  position: absolute;
  right: -10rpx;
  top: -20rpx;
  width: 150rpx;
  height: 150rpx;
  opacity: 0.34;
  pointer-events: none;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.brand-row {
  display: flex;
  align-items: flex-start;
}

.brand-cn {
  font-size: 54rpx;
  font-weight: 600;
  letter-spacing: 12rpx;
  color: var(--fk-ink-900);
  line-height: 1.15;
}

.brand-seal {
  margin-left: 8rpx;
  margin-top: 10rpx;
  transform: rotate(6deg);
}

.brand-en {
  margin-top: 10rpx;
}

.hero-acts {
  display: flex;
  align-items: center;
  padding-top: 6rpx;
}

.act-txt {
  position: relative;
  margin-left: 28rpx;
  font-size: 24rpx;
  color: var(--fk-ink-500);
  letter-spacing: 2rpx;
}

.act-dot {
  position: absolute;
  right: -12rpx;
  top: -4rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--fk-seal);
}

.hero-hello {
  margin-top: 44rpx;
  font-size: 30rpx;
  color: var(--fk-ink-700);
  letter-spacing: 1rpx;
}

.hero-hello .num {
  font-size: 42rpx;
  font-weight: 600;
  color: var(--fk-brand-dark);
  margin: 0 4rpx;
}

.hero-tip {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--fk-ink-300);
  letter-spacing: 1rpx;
}

/* ── 拍照识菜 ─────────────────────────────────────────── */
.capture {
  padding: 32rpx;
}

.capture-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.capture-title {
  font-size: 42rpx;
  font-weight: 600;
  letter-spacing: 5rpx;
  color: var(--fk-ink-900);
}

.capture-en {
  margin-top: 12rpx;
}

.capture-sub {
  margin-top: 22rpx;
  font-size: 23rpx;
  color: var(--fk-ink-500);
  letter-spacing: 1rpx;
}

.capture-badge {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: var(--fk-brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.capture-icon {
  width: 66rpx;
  height: 66rpx;
}

.tiles {
  display: flex;
  justify-content: space-between;
}

.tiles > .fk-tile {
  width: 23.5%;
}

/* ── 冰箱状态 ─────────────────────────────────────────── */
.stat {
  margin-top: 28rpx;
  padding: 32rpx;
}

.stat-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stat-title {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  color: var(--fk-ink-900);
}

.stat-more {
  font-size: 22rpx;
  color: var(--fk-ink-300);
  padding-top: 8rpx;
}

.stat-nums {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
}

.sn {
  flex: 1;
  text-align: center;
}

.sn-line {
  width: 2rpx;
  height: 48rpx;
  background: var(--fk-line);
}

.sn-num {
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1.1;
  color: var(--fk-ink-900);
}

.sn-num.warn {
  color: var(--fk-warn);
}

.sn-label {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: var(--fk-ink-300);
  letter-spacing: 1rpx;
}

.stat-bar {
  margin-top: 32rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: var(--fk-fill);
  display: flex;
  overflow: hidden;
}

.sb2 {
  height: 100%;
  transition: width 0.4s ease;
}

.sb2.fresh {
  background: var(--fk-brand);
}

.sb2.soon {
  background: var(--fk-warn);
}

.sb2.expired {
  background: var(--fk-danger);
}

.stat-legend {
  margin-top: 20rpx;
  display: flex;
  justify-content: space-between;
}

.lg {
  display: flex;
  align-items: center;
  font-size: 21rpx;
  color: var(--fk-ink-500);
}

.lg-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.lg-dot.fresh {
  background: var(--fk-brand);
}

.lg-dot.soon {
  background: var(--fk-warn);
}

.lg-dot.expired {
  background: var(--fk-danger);
}

/* ── 区块 ─────────────────────────────────────────────── */
.section {
  margin-top: 48rpx;
}

.sec-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.sec-title {
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 5rpx;
  color: var(--fk-ink-900);
}

.sec-en {
  margin-top: 12rpx;
}

.sec-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--fk-ink-300);
  letter-spacing: 1rpx;
}

.sec-more {
  font-size: 22rpx;
  color: var(--fk-ink-300);
  padding-bottom: 4rpx;
}

.exp-list > expiration-card,
.recipe-list > recipe-card {
  display: block;
  margin-bottom: 20rpx;
}

.more {
  text-align: center;
  font-size: 23rpx;
  color: var(--fk-ink-300);
  padding: 10rpx 0 4rpx;
  letter-spacing: 1rpx;
}

/* ── 空态 ─────────────────────────────────────────────── */
.empty {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx;
}

.empty-illu {
  width: 380rpx;
  height: 380rpx;
  opacity: 0.9;
}

.empty-title {
  margin-top: 32rpx;
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
  color: var(--fk-ink-900);
}

.empty-desc {
  margin-top: 14rpx;
  font-size: 23rpx;
  line-height: 1.8;
  color: var(--fk-ink-500);
  text-align: center;
  max-width: 460rpx;
}

.empty-btn {
  margin-top: 38rpx;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 56rpx;
  border-radius: var(--fk-r-pill);
  background: var(--fk-brand);
  color: #fff;
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

/* ── 通知抽屉 ─────────────────────────────────────────── */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(61, 74, 58, 0.32);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: var(--fk-card);
  border-radius: 36rpx 36rpx 0 0;
  padding: 20rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  animation: fk-fade-up 0.26s ease both;
}

.sheet-bar {
  width: 72rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: var(--fk-line-strong);
  margin: 8rpx auto 24rpx;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--fk-ink-900);
}

.sheet-read {
  font-size: 23rpx;
  color: var(--fk-brand);
}

.sheet-body {
  max-height: 60vh;
  margin-top: 20rpx;
}

.nt {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--fk-line);
}

.nt-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-top: 12rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
  background: var(--fk-brand);
}

.nt-dot.soon {
  background: var(--fk-warn);
}

.nt-dot.urgent {
  background: var(--fk-warn);
}

.nt-dot.expired {
  background: var(--fk-danger);
}

.nt-title {
  font-size: 27rpx;
  color: var(--fk-ink-900);
  letter-spacing: 1rpx;
}

.nt-body {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--fk-ink-500);
  line-height: 1.7;
}

.nt-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--fk-ink-300);
}
