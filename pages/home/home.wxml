<view class="page">

  <!-- ── Hero：品牌 + 今日建议 ───────────────────────────── -->
  <view class="hero">
    <image class="hero-leaf fk-float" src="/assets/illustration/leaf-deco.png" />

    <view class="hero-top">
      <view class="brand">
        <view class="brand-row">
          <text class="brand-cn">鲜存</text>
          <view class="fk-seal brand-seal">鲜</view>
        </view>
        <view class="fk-en-sub brand-en">Fresh Keep</view>
      </view>

      <view class="hero-acts">
        <view class="act-txt" bindtap="openNotify">
          提醒
          <view class="act-dot" wx:if="{{reminderCount > 0}}"></view>
        </view>
        <view class="act-txt" bindtap="goSettings">设置</view>
      </view>
    </view>

    <view class="hero-hello">{{greeting}}，今天冰箱里有 <text class="num">{{stats.kinds}}</text> 种食材</view>
    <view class="hero-tip">{{suggestion}}</view>
  </view>

  <!-- ── 拍照识菜 ───────────────────────────────────────── -->
  <view class="capture fk-paper fk-rise fk-d1">
    <view class="capture-head" bindtap="goScan">
      <view class="capture-main">
        <view class="capture-title">拍照识别食材</view>
        <view class="fk-en-sub capture-en">AI Recognition</view>
      </view>
      <view class="capture-badge">
        <image class="capture-icon" src="/assets/icon/i-camera.png" mode="aspectFit" />
      </view>
    </view>

    <view class="capture-sub">买菜回来，拍一下就知道怎么放</view>

    <view class="fk-hairline"></view>

    <view class="tiles">
      <view class="fk-tile" bindtap="quickCamera">
        <image class="fk-tile-icon" src="/assets/icon/i-camera.png" mode="aspectFit" />
        <text class="fk-tile-text">拍照</text>
      </view>
      <view class="fk-tile" bindtap="quickAlbum">
        <image class="fk-tile-icon" src="/assets/icon/i-album.png" mode="aspectFit" />
        <text class="fk-tile-text">相册</text>
      </view>
      <view class="fk-tile" bindtap="quickManual">
        <image class="fk-tile-icon" src="/assets/icon/i-pen.png" mode="aspectFit" />
        <text class="fk-tile-text">手动</text>
      </view>
      <view class="fk-tile" bindtap="goFridge">
        <image class="fk-tile-icon" src="/assets/icon/i-fridge.png" mode="aspectFit" />
        <text class="fk-tile-text">冰箱</text>
      </view>
    </view>
  </view>

  <!-- ── 今日冰箱状态 ───────────────────────────────────── -->
  <view class="stat fk-paper fk-rise fk-d2">
    <view class="stat-head">
      <view>
        <text class="stat-title">今日冰箱状态</text>
        <view class="fk-title-rule"></view>
      </view>
      <text class="stat-more" bindtap="goFridge">全部 ›</text>
    </view>

    <view class="stat-nums">
      <view class="sn">
        <view class="sn-num">{{stats.kinds}}</view>
        <view class="sn-label">种食材</view>
      </view>
      <view class="sn-line"></view>
      <view class="sn">
        <view class="sn-num">{{stats.items}}</view>
        <view class="sn-label">件</view>
      </view>
      <view class="sn-line"></view>
      <view class="sn">
        <view class="sn-num warn">{{stats.soon + stats.urgent}}</view>
        <view class="sn-label">即将过期</view>
      </view>
    </view>

    <view class="stat-bar" wx:if="{{stats.kinds > 0}}">
      <view class="sb2 fresh" style="width: {{bar.fresh}}%;"></view>
      <view class="sb2 soon" style="width: {{bar.soon}}%;"></view>
      <view class="sb2 expired" style="width: {{bar.expired}}%;"></view>
    </view>

    <view class="stat-legend" wx:if="{{stats.kinds > 0}}">
      <view class="lg"><view class="lg-dot fresh"></view>新鲜 {{stats.fresh}}</view>
      <view class="lg"><view class="lg-dot soon"></view>临期 {{stats.soon + stats.urgent}}</view>
      <view class="lg"><view class="lg-dot expired"></view>已过期 {{stats.expired}}</view>
    </view>
  </view>

  <!-- ── 临期提醒 ───────────────────────────────────────── -->
  <view class="section fk-rise fk-d3" wx:if="{{expiring.length > 0}}">
    <view class="sec-head">
      <view>
        <view class="sec-title">临期提醒</view>
        <view class="fk-title-rule"></view>
      </view>
      <text class="sec-more" bindtap="goFridge">全部 ›</text>
    </view>

    <view class="exp-list">
      <expiration-card
        wx:for="{{expiring}}"
        wx:for-item="it"
        wx:key="id"
        item="{{it}}"
        suggestion="{{it.suggestion}}"
        bind:cook="onCook"
        bind:tap="onIngredientTap"
      />
    </view>
  </view>

  <!-- ── 今天吃什么 ─────────────────────────────────────── -->
  <view class="section fk-rise fk-d4" wx:if="{{recipes.length > 0}}">
    <view class="sec-head">
      <view>
        <view class="sec-title">今天吃什么</view>
        <view class="fk-en-sub sec-en">Today's Menu</view>
        <view class="fk-title-rule"></view>
      </view>
    </view>

    <view class="recipe-list">
      <recipe-card
        wx:for="{{recipes}}"
        wx:for-item="r"
        wx:key="index"
        item="{{r}}"
        bind:tap="goRecipe"
      />
    </view>

    <view class="more" bindtap="goMore">查看更多推荐 ›</view>
  </view>

  <!-- ── 空态 ──────────────────────────────────────────── -->
  <view class="empty fk-rise fk-d2" wx:if="{{stats.kinds === 0 && !loading}}">
    <image class="empty-illu fk-float" src="/assets/illustration/empty-fridge.png" mode="aspectFit" />
    <view class="empty-title">冰箱还空着</view>
    <view class="empty-desc">买菜回来拍张照，AI 帮你判断怎么放、放多久。</view>
    <view class="empty-btn" bindtap="goScan">拍照识别食材</view>
  </view>

  <view class="fk-disclaimer">
    保存时长为参考值，仅供食材管理使用，实际情况请结合食材状态判断。
  </view>
</view>

<!-- ── 通知中心抽屉 ─────────────────────────────────────── -->
<view class="mask" wx:if="{{showNotify}}" bindtap="closeNotify">
  <view class="sheet" catchtap="noop">
    <view class="sheet-bar"></view>
    <view class="sheet-head">
      <view class="sheet-title">⏰ 食材提醒</view>
      <view class="sheet-read" bindtap="readAll">全部已读</view>
    </view>
    <scroll-view scroll-y class="sheet-body">
      <view class="nt" wx:for="{{reminders}}" wx:for-item="n" wx:key="id">
        <view class="nt-dot {{n.level}}"></view>
        <view class="nt-main">
          <view class="nt-title">{{n.title}}</view>
          <view class="nt-body">{{n.body}}</view>
        </view>
      </view>
      <view wx:if="{{reminders.length === 0}}" class="nt-empty">
        暂时没有提醒，冰箱状态不错
      </view>
    </scroll-view>
    <view class="fk-disclaimer">提醒基于你记录的最佳食用期，仅供参考。</view>
  </view>
</view>
